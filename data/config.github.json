{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": {
        "threshold": 7.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "industry-voices",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "official-tools",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "anthropic-sdk-python",
        "enabled": true,
        "category": "official-tools",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "googleapis",
        "repo": "python-genai",
        "enabled": true,
        "category": "official-tools",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "open-source",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "ollama",
        "repo": "ollama",
        "enabled": true,
        "category": "open-source",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "Comfy-Org",
        "repo": "ComfyUI",
        "enabled": true,
        "category": "creator-tools",
        "profile": "ai-creator"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 25,
      "min_score": 100,
      "category": "community",
      "profile": "ai-creator"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "official-models",
        "profile": "ai-creator",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google AI",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "official-models",
        "profile": "ai-creator",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "official-research",
        "profile": "ai-creator",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "open-source",
        "profile": "ai-creator",
        "content_extractor": "trafilatura"
      },
      {
        "name": "NVIDIA AI Blog",
        "url": "https://developer.nvidia.com/blog/category/artificial-intelligence-data-science/feed/",
        "enabled": true,
        "category": "official-tools",
        "profile": "ai-creator",
        "content_extractor": "trafilatura"
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "media",
        "profile": "ai-creator",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "open-source",
        "profile": "ai-creator"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "community",
          "profile": "ai-creator"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "community",
          "profile": "ai-creator"
        }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "chinese-news",
          "profile": "ai-creator"
        }
      ]
    },
    "twitter": {
      "enabled": false,
      "mode": "apify",
      "users": [],
      "keywords": [],
      "fetch_limit": 10,
      "category": "community",
      "profile": "ai-creator"
    },
    "openbb": {
      "enabled": false,
      "watchlists": [],
      "fetch_filings": false,
      "filings_provider": "sec"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "llm",
        "agent",
        "multimodal",
        "diffusion",
        "image",
        "video"
      ],
      "min_stars": 10,
      "max_items": 12,
      "category": "open-source",
      "profile": "ai-creator"
    },
    "gdelt": {
      "enabled": false,
      "query": "artificial intelligence",
      "mode": "ArtList",
      "max_records": 50,
      "timespan": "24h",
      "language": null,
      "country": null,
      "category": "media",
      "profile": "ai-creator"
    },
    "google_news": {
      "enabled": true,
      "query": "人工智能 OR 大模型 OR 生成式AI OR AI视频",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 30,
      "category": "news-search",
      "profile": "ai-creator"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 12,
    "profile_order": [
      "ai-creator"
    ],
    "category_groups": {
      "official": {
        "name": "官方发布与研究",
        "limit": 6,
        "categories": [
          "official-models",
          "official-research",
          "official-tools"
        ]
      },
      "open_source": {
        "name": "开源项目与创作工具",
        "limit": 4,
        "categories": [
          "open-source",
          "creator-tools"
        ]
      },
      "community": {
        "name": "社区讨论与行业声音",
        "limit": 3,
        "categories": [
          "community",
          "industry-voices",
          "chinese-news"
        ]
      },
      "media": {
        "name": "媒体与中文搜索",
        "limit": 3,
        "categories": [
          "media",
          "news-search"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": null,
    "headers": ""
  }
}
